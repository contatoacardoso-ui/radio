<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    
    <!-- Configurações PWA Mobile (Para rodar como App) -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WebRadio App">
    <meta name="theme-color" content="#121212">
    
    <title>Radio Player Mobile</title>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/shaka-player/4.3.5/shaka-player.compiled.js"></script>
    
    <style>
        :root {
            --accent: #00f2ff;
            --bg-main: #121212;
            --bg-card: #1e1e1e;
            --bg-card-hover: #2a2a2a;
            --text-main: #ffffff;
            --text-muted: #aaaaaa;
            --bottom-bar-h: 70px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* Top Header App Bar */
        .app-header {
            padding: 20px 20px 10px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(18, 18, 18, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #222;
        }

        .app-header h1 {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .badge-live {
            background: #ff0055;
            color: #fff;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        /* Área de Conteúdo / Playlist Scrollável */
        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            padding-bottom: calc(var(--bottom-bar-h) + 20px);
        }

        .section-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 12px;
            margin-top: 10px;
        }

        .playlist-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .track-card {
            background: var(--bg-card);
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background 0.2s;
        }

        .track-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
            overflow: hidden;
        }

        .track-title {
            font-size: 14px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .track-artist {
            font-size: 12px;
            color: var(--text-muted);
        }

        .track-card.active {
            border-color: var(--accent);
            background: rgba(0, 242, 255, 0.05);
        }

        .track-card.active .track-title {
            color: var(--accent);
        }

        /* Barra Inferior (Fixed Player Bar) */
        .bottom-player {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: var(--bottom-bar-h);
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(15px);
            border-top: 1px solid #333;
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 15px;
            box-shadow: 0 -10px 25px rgba(0,0,0,0.5);
            z-index: 100;
        }

        .now-playing-info {
            flex: 1;
            overflow: hidden;
        }

        .now-title {
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .now-artist {
            font-size: 11px;
            color: var(--accent);
            margin-top: 2px;
        }

        /* Controles */
        .play-btn {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--accent);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 0 15px rgba(0, 242, 255, 0.4);
        }

        .play-btn svg { width: 18px; height: 18px; fill: #000; }

        /* Equalizador de Ondas Sonoras */
        .wave-box {
            display: flex;
            align-items: center;
            gap: 3px;
            height: 16px;
        }

        .wave-bar {
            width: 3px;
            height: 4px;
            background: var(--accent);
            border-radius: 2px;
            transition: height 0.2s;
        }

        .playing .wave-bar {
            animation: wave 0.8s infinite ease-in-out;
        }

        .playing .wave-bar:nth-child(2) { animation-delay: 0.15s; }
        .playing .wave-bar:nth-child(3) { animation-delay: 0.3s; }
        .playing .wave-bar:nth-child(4) { animation-delay: 0.45s; }

        @keyframes wave {
            0%, 100% { height: 4px; }
            50% { height: 16px; }
        }

        audio { display: none; }
    </style>
</head>
<body>

    <!-- Header Estilo App -->
    <header class="app-header">
        <h1>WebRadio <span class="badge-live">Ao Vivo</span></h1>
    </header>

    <!-- Conteúdo do App (Programação/Playlist) -->
    <main class="app-content">
        <div class="section-title">Programação em Loop</div>
        <div class="playlist-container" id="playlistItems">
            <!-- Gerado via JavaScript -->
        </div>
    </main>

    <!-- Player Fixo no Rodapé -->
    <div class="bottom-player" id="playerBar">
        <button class="play-btn" onclick="togglePlay()">
            <svg id="playIcon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        </button>

        <div class="now-playing-info">
            <div class="now-title" id="trackTitle">Sintonizando...</div>
            <div class="now-artist" id="trackArtist">Aguarde</div>
        </div>

        <div class="wave-box" id="waveBox">
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
            <div class="wave-bar"></div>
        </div>
    </div>

    <audio id="audioEngine" autoplay></audio>

    <script>
        // Array da Playlist (Adicione novos links aqui)
        const playlist = [
            {
                title: "Radio Bullguer programa 82",
                artist: "MPB & Bossa Nova",
                url: "https://audio.mixcloud.stream/secure/dash2/c/b/3/a/8d90-c972-4c01-8e71-a0d7fc36bdd3.m4a/manifest.mpd",
                isDash: true
            },
            {
                title: "We Came to Party",
                artist: "Live Mix",
                url: "https://rr3---sn-gpv7kn7y.c.youtube.com/videoplayback?expire=1774869284&ei=xAbKafOIEvuQ-LAP_drK2Ak&ip=2804%3A52b8%3Ac013%3Ace00%3A6553%3Abe1b%3Acc4d%3A90a7&id=o-ACINNUMIKcgXCrQKZGKvIF7QEr6E94I8_Mk0EI2U90Fz&itag=140&source=youtube&requiressl=yes&xpc=EgVo2aDSNQ%3D%3D&met=1774847684%2C&mh=fp&mm=32%2C26&mn=sn-gpv7kn7y%2Csn-bg0s7n7s&ms=su%2Conr&mv=m&mvi=3&pl=34&rms=su%2Csu&sc=yes&gcr=br&initcwndbps=2651250&siu=1&bui=AUUZDGI8vH6VTLghkfz15wBgIq_57iLbi5QvaqZkQ8Umw8WJO2PRGtouA7KRnhGNMtI7eo-kHA&vprv=1&prv=1&svpuc=1&mime=audio%2Fmp4&ns=dnG76byPk4sy4G7_cIS5tzUT&rqh=1&gir=yes&clen=102555043&dur=6336.678&lmt=1749693661058814&mt=1774847333&fvip=4&keepalive=yes&lmw=1&fexp=51565116%2C51565681&c=TVHTML5&sefc=1&txp=0000224&n=Ct2MNwtv6uOzig&sparams=expire%2Cei%2Cip%2Cid%2Citag%2Csource%2Crequiressl%2Cxpc%2Cgcr%2Csiu%2Cbui%2Cvprv%2Cprv%2Csvpuc%2Cmime%2Cns%2Crqh%2Cgir%2Cclen%2Cdur%2Clmt&sig=AHEqNM4wRQIhAKpHaMGmOxuGsYwmE5WDRJbD5jQ1OA9NcywowW1Qk_syAiAw1M_ETr0dOsUf4Ry9HuKGbF22lxDRKYVuSK2byB9ELQ%3D%3D&lsparams=met%2Cmh%2Cmm%2Cmn%2Cms%2Cmv%2Cmvi%2Cpl%2Crms%2Csc%2Cinitcwndbps&lsig=APaTxxMwRAIgYOF_b0cTCDcde9i9k661Og9525X2WlZWkESvXtqp1QYCIEBKTLBdokhhoqY651d1MNpdMadTHOmLIgSnzaLigpSW",
                isDash: false
            }
        ];

        let currentIndex = -1;
        let shakaPlayer;
        const audio = document.getElementById('audioEngine');
        const playIcon = document.getElementById('playIcon');
        const playerBar = document.getElementById('playerBar');

        async function initApp() {
            shaka.polyfill.installAll();
            shakaPlayer = new shaka.Player(audio);

            renderPlaylistUI();

            audio.onended = () => {
                playRandomTrack();
            };

            playRandomTrack();
        }

        function playRandomTrack() {
            let nextIndex;
            if (playlist.length > 1) {
                do {
                    nextIndex = Math.floor(Math.random() * playlist.length);
                } while (nextIndex === currentIndex);
            } else {
                nextIndex = 0;
            }

            currentIndex = nextIndex;
            loadTrack(currentIndex);
        }

        async function loadTrack(index) {
            const track = playlist[index];
            document.getElementById('trackTitle').innerText = track.title;
            document.getElementById('trackArtist').innerText = track.artist;

            updatePlaylistHighlight();

            try {
                if (track.isDash) {
                    await shakaPlayer.load(track.url);
                } else {
                    await shakaPlayer.unload();
                    audio.src = track.url;
                }

                let playPromise = audio.play();
                if (playPromise !== undefined) {
                    playPromise.then(() => {
                        setUIState(true);
                    }).catch(() => {
                        // Trata a restrição de autoplay sem clique prévio do usuário
                        audio.muted = true;
                        audio.play();
                        setUIState(true);
                    });
                }
            } catch (e) {
                console.error("Erro ao reproduzir a faixa, tentando outra...", e);
                setTimeout(playRandomTrack, 1000);
            }
        }

        function togglePlay() {
            if (audio.paused) {
                audio.muted = false;
                audio.play();
                setUIState(true);
            } else {
                audio.pause();
                setUIState(false);
            }
        }

        function setUIState(isPlaying) {
            if (isPlaying) {
                playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                playerBar.classList.add('playing');
            } else {
                playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                playerBar.classList.remove('playing');
            }
        }

        function renderPlaylistUI() {
            const container = document.getElementById('playlistItems');
            container.innerHTML = '';

            playlist.forEach((item, i) => {
                const card = document.createElement('div');
                card.className = 'track-card';
                card.id = `track-card-${i}`;
                card.innerHTML = `
                    <div class="track-info">
                        <div class="track-title">${item.title}</div>
                        <div class="track-artist">${item.artist}</div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function updatePlaylistHighlight() {
            playlist.forEach((_, i) => {
                const el = document.getElementById(`track-card-${i}`);
                if (el) {
                    if (i === currentIndex) el.classList.add('active');
                    else el.classList.remove('active');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
